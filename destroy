#!/usr/bin/env python3
"""Preview or remove one released Git worktree, retaining its branch."""
import argparse
import os
from pathlib import Path
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('worktree', type=Path)
    parser.add_argument('--base', default='origin/main', help='Integration ref containing the work (default: origin/main; not fetched automatically)')
    parser.add_argument('--apply', action='store_true', help='Run cleanup and remove the worktree')
    parser.add_argument('--released', action='store_true', help='Confirm no person, agent, service, or reserved resource still uses this worktree; needed with --apply')
    parser.add_argument('--resources-cleaned', action='store_true', help='Confirm repository resources were already cleaned manually; used only when no cleanup hook exists')
    args = parser.parse_args()

    def fail(message):
        raise RuntimeError(message)

    raw = args.worktree.absolute()
    target = raw.resolve(strict=True)
    if raw != target:
        fail('Use the canonical worktree path, without symlinks or .. components.')

    def git(*command):
        result = subprocess.run(['git', '-C', str(target), *command], capture_output=True, text=True)
        if result.returncode:
            fail(result.stderr.strip() or 'Git check failed.')
        return result.stdout.strip()

    if Path(git('rev-parse', '--show-toplevel')).resolve() != target:
        fail('Specify the worktree root, not a subdirectory.')
    common = Path(git('rev-parse', '--path-format=absolute', '--git-common-dir')).resolve()
    gitdir = Path(git('rev-parse', '--absolute-git-dir')).resolve()
    if gitdir == common:
        fail('Refusing to remove the primary checkout.')
    records = git('worktree', 'list', '--porcelain', '-z').split('\0\0')
    record = next((r.split('\0') for r in records if r.split('\0')[0] == 'worktree ' + str(target)), None)
    if record is None:
        fail('Target is not a registered linked worktree.')
    if any(line == 'locked' or line.startswith('locked ') for line in record):
        fail('Worktree is locked; retain it until its owner releases it.')
    if Path.cwd().resolve() == target or target in Path.cwd().resolve().parents:
        fail('Run cleanup from outside the target worktree.')

    base = git('rev-parse', '--verify', '--end-of-options', args.base + '^{commit}')
    head = git('rev-parse', 'HEAD')

    def check():
        if git('status', '--porcelain', '--untracked-files=all'):
            fail('Worktree has tracked changes or untracked files; preserve them first.')
        if git('rev-parse', 'HEAD') != head:
            fail('Worktree HEAD changed during cleanup.')
        result = subprocess.run(['git', '-C', str(target), 'merge-base', '--is-ancestor', head, base])
        if result.returncode:
            fail('HEAD is not contained in the integration ref. Squash/rebase merges require separate reconciliation; no force removal is provided.')
        if any((gitdir / name).exists() for name in ('MERGE_HEAD', 'CHERRY_PICK_HEAD', 'REVERT_HEAD', 'rebase-merge', 'rebase-apply', 'index.lock', 'locked')):
            fail('Git operation or worktree lock is present.')

    check()
    hook = target / '.codex/cleanup.sh'
    setup = target / '.codex/setup.sh'
    print('Worktree:', target, flush=True)
    print('Integration commit:', base, flush=True)
    print('Branch will be retained. Ignored files inside the worktree will be removed with it.', flush=True)
    if hook.exists():
        print('Repository cleanup hook:', hook, flush=True)
    elif setup.exists() and not args.resources_cleaned:
        fail('Repository has setup.sh but no cleanup.sh. Add a cleanup hook, or finish repository teardown and acknowledge it with --resources-cleaned.')
    if not args.apply:
        print('Preview only. Removal requires --apply --released.')
        return
    if not args.released:
        fail('--apply requires --released after verifying the task and its resources are no longer in use.')
    if hook.exists():
        if hook.is_symlink():
            fail('Cleanup hook must not be a symlink.')
        env = dict(os.environ, AGENT_WORKTREE_PATH=str(target), AGENT_CLEANUP_BASE=base)
        # Hook contract: --check is read-only; --apply performs owned teardown.
        for mode in ('--check', '--apply'):
            check()
            subprocess.run(['bash', str(hook), mode], cwd=target, env=env, check=True)
    check()
    subprocess.run(['git', '--git-dir', str(common), 'worktree', 'remove', str(target)], check=True)
    print('Removed worktree. Git branch and parent directory retained.')


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError, subprocess.CalledProcessError) as error:
        print('Cleanup stopped:', error, file=sys.stderr)
        sys.exit(1)
